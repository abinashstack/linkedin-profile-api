# Fastest / most reliable path: log into linkedin.com in a normal browser once,
# open devtools -> Application -> Cookies, and copy the value of `li_at`.
LINKEDIN_LI_AT=

# Fallback: used only if LINKEDIN_LI_AT is not set. The backend will POST these
# to LinkedIn's login endpoint itself (no browser involved). This frequently
# gets challenged by LinkedIn on unfamiliar / datacenter IPs -- see the
# README's "Known limitations" section.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# How long a parsed profile is cached in memory before LinkedIn is hit again, in seconds.
CACHE_TTL_SECONDS=3600
